# =============================================================
# sso-bff 配置（.env.example）——复制为 .env 后按环境填写
# 计费红线：本文件含 new-api 管理员口令等机密，禁止提交 Git
# =============================================================

# ---- BFF 自身 ----
SSO_BFF_ENV=dev                       # dev / prod
SSO_BFF_BASE_URL=http://localhost:8800 # BFF 对外基址（生产 https://sso.1task.cn）
SSO_BFF_SESSION_COOKIE=sso_session
SSO_BFF_SESSION_TTL_HOURS=168         # 会话有效期（7 天，随 IdP refresh 续期）
SSO_BFF_STATE_TTL_SECONDS=600         # OIDC state/nonce/PKCE 存活时长

# ---- Redis（会话 + JIT 锁 + 令牌缓存）----
SSO_BFF_REDIS_URL=redis://127.0.0.1:6379/0

# ---- 数据库（identity_mapping）----
# dev: sqlite+aiosqlite:///./sso_bff.db   prod: mysql+aiomysql://user:pass@host:3306/sso_bff
SSO_BFF_DATABASE_URL=sqlite+aiosqlite:///./sso_bff.db

# ---- 密钥（Fernet，加密 sk- key 与 new-api 用户口令）----
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产环境必须显式设置；dev 缺省时自动生成并落盘 .dev_fernet_key（仅限开发）
SSO_BFF_CRYPTO_KEY=

# ---- OIDC / Casdoor（IdP）----
SSO_BFF_OIDC_ISSUER=http://localhost:9000        # Casdoor 基址
SSO_BFF_OIDC_CLIENT_ID=sso-bff-app               # BFF 在 Casdoor 的 Application
SSO_BFF_OIDC_CLIENT_SECRET=change-me
SSO_BFF_OIDC_SCOPE=openid profile phone
SSO_BFF_OIDC_REDIRECT_PATH=/auth/callback        # 回调路径（挂在 BASE_URL 下）
# IdP 管理接口（封禁级联轮询用户状态用；Casdoor 用 admin token，mock 用本地端点）
SSO_BFF_IDP_ADMIN_TYPE=casdoor                   # casdoor / mock
SSO_BFF_IDP_ADMIN_ENDPOINT=                       # casdoor: 组织用户列表 API；mock: /admin/users
SSO_BFF_IDP_ADMIN_TOKEN=

# ---- new-api（模型网关，计费主体）----
SSO_BFF_NEWAPI_BASE_URL=https://newapi-0to1.livetest.cn
SSO_BFF_NEWAPI_ADMIN_USERNAME=root
SSO_BFF_NEWAPI_ADMIN_PASSWORD=
# JIT 默认套餐：新用户令牌额度与有效期（-1=永不过期；额度单位与 new-api 一致）
SSO_BFF_NEWAPI_DEFAULT_QUOTA=500000
SSO_BFF_NEWAPI_DEFAULT_EXPIRED_TIME=-1
SSO_BFF_NEWAPI_DEFAULT_UNLIMITED_QUOTA=true
SSO_BFF_NEWAPI_TOKEN_NAME=sso-bff
# 账号名前缀（new-api 用户名上限 20 字符，sub 取 base32 前 11 位）
SSO_BFF_NEWAPI_USER_PREFIX=sso_

# ---- 后台任务 ----
SSO_BFF_BAN_CASCADE_INTERVAL_SECONDS=60          # 封禁级联轮询（分钟级）
SSO_BFF_RECONCILE_INTERVAL_SECONDS=3600          # 定期对账
SSO_BFF_BACKGROUND_TASKS=true

# ---- 演示前端（F3）----
SSO_BFF_DEMO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
